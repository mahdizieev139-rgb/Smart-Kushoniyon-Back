# =========================================================================
# KUSHONIYON SMART MARKET — Backend Environment Variables (EXAMPLE)
# -------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit your real `.env` file. NEVER put real secrets in this file.
# All required variables are validated at server startup (see src/config/env.ts).
# =========================================================================

# ---- Core application ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ---- Database (PostgreSQL) ----
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kushoniyon?schema=public

# ---- JWT secrets ----
# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters long.
ACCESS_TOKEN_SECRET=replace_with_long_random_access_secret_min_32_chars
REFRESH_TOKEN_SECRET=replace_with_long_random_refresh_secret_min_32_chars

# Token lifetimes (zeit/ms format: 15m, 1h, 7d, 30d)
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# ---- Frontend / CORS ----
FRONTEND_URL=http://localhost:3000
# Comma-separated allowlist of origins permitted to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Cookies ----
# Name of the HttpOnly cookie that stores the refresh token.
REFRESH_COOKIE_NAME=kushoniyon_rt
# In production set COOKIE_SECURE=true (requires HTTPS).
COOKIE_SECURE=false
# "lax" for local dev, "none" only when frontend is on a different site over HTTPS.
COOKIE_SAMESITE=lax

# ---- Object storage (S3-compatible) ----
# STORAGE_DRIVER selects the adapter: "local" (dev) or "s3" (production).
STORAGE_DRIVER=local

# Used only when STORAGE_DRIVER=local — files are written under this folder.
LOCAL_STORAGE_DIR=uploads
# Public base URL the API uses to serve locally-stored files.
LOCAL_STORAGE_PUBLIC_URL=http://localhost:4000/uploads

# Used only when STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Public base URL (CDN or bucket URL) used to build image URLs returned by the API.
STORAGE_PUBLIC_URL=

# ---- Uploads ----
# Max image size in bytes (default 5 MB).
MAX_UPLOAD_SIZE_BYTES=5242880

# ---- Rate limiting ----
# General API window (ms) and max requests per window per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter limits for auth endpoints (login/register).
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ---- Logging ----
# Pino level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- Bootstrap SUPER_ADMIN (used by `npm run create:superadmin` and `npm run db:seed`) ----
# Change these before using on any real environment.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@kushoniyon.local
SUPER_ADMIN_PASSWORD=ChangeMe_Str0ng!
