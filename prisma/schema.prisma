// =========================================================================
// KUSHONIYON SMART MARKET — Prisma schema
// -------------------------------------------------------------------------
// Design notes (read these first, they explain the "why"):
//
// 1. Multilingual content (tj / ru / en) lives in separate *Translation
//    tables instead of columns like name_tj, name_ru. This keeps the core
//    tables clean and lets us add locales later without schema changes.
//
// 2. Monetary values use Decimal, never Float. Float cannot represent money
//    exactly and causes rounding bugs. price Decimal(12, 2) = up to 10 digits
//    before the dot + 2 after.
//
// 3. Primary keys are UUIDs (generated by the database with gen_random_uuid()).
//    UUIDs avoid leaking row counts and are safe to expose in URLs.
//
// 4. Soft deletion: tables that users "delete" keep a deletedAt timestamp
//    instead of really removing the row. Our queries filter deletedAt = null.
//
// 5. Secrets (refresh tokens, reset tokens) are stored HASHED, never in
//    plaintext, so a database leak does not hand out valid tokens.
// =========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------------
// Enums
// -------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

// Role of a user *inside* a specific shop (a user may belong to several shops).
enum ShopMemberRole {
  OWNER
  MANAGER
  STAFF
}

enum ProductStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  // Added in v2: LIMITED_STOCK (few left) and UNKNOWN (seller hasn't set it).
  LIMITED_STOCK
  UNKNOWN
  PREORDER
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

// Generic status reused by gates and sections.
enum PlacementStatus {
  ACTIVE
  INACTIVE
}

enum AdvertisementStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  ENDED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  UNPAID
  PAID
  REFUNDED
  VOID
}

enum Locale {
  tj
  ru
  en
}

// v2: in-app notification categories.
enum NotificationType {
  PRICE_CHANGED
  PRODUCT_AVAILABLE
  SHOP_UPDATED
  INQUIRY_RECEIVED
  INQUIRY_REPLIED
}

// v2: customer-seller inquiry lifecycle.
enum InquiryStatus {
  OPEN
  RESOLVED
}

// -------------------------------------------------------------------------
// Users & authentication
// -------------------------------------------------------------------------

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  // Either email or phone can be used to log in; at least one is required
  // (enforced in the service/validation layer, not by the DB).
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  shopMemberships     ShopMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  // v2 relations
  favoriteProducts    FavoriteProduct[]
  favoriteShops       FavoriteShop[]
  notifications       Notification[]
  inquiries           Inquiry[]          @relation("CustomerInquiries")
  inquiryMessages     InquiryMessage[]

  @@index([role])
  @@index([status])
  @@map("users")
}

// One row per active refresh token (one per device/login session).
// We store only a HASH of the token. Rotation revokes the old row and
// creates a new one. Logout revokes the row.
model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  // When rotated, references the token that replaced this one (we store the
  // replacement token's hash, so this is a plain string, not a UUID).
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -------------------------------------------------------------------------
// Shops
// -------------------------------------------------------------------------

model Shop {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String     @unique
  phone     String?
  status    ShopStatus @default(PENDING)
  sectionId String?    @db.Uuid
  // v2: physical stall number within the market (for navigation).
  shopNumber String?
  // v2: explicit demo flag so seed/demo rows are clearly marked.
  isDemo     Boolean   @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  section      Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  translations ShopTranslation[]
  members      ShopMember[]
  products     Product[]
  advertisements Advertisement[]
  subscriptions  Subscription[]

  // v2 relations
  favoritedBy FavoriteShop[]
  views       ShopView[]
  inquiries   Inquiry[]

  @@index([status])
  @@index([sectionId])
  @@index([deletedAt])
  @@index([shopNumber])
  @@map("shops")
}

model ShopTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String  @db.Uuid
  locale      Locale
  name        String
  description String?

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, locale])
  @@index([name])
  @@map("shop_translations")
}

model ShopMember {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @db.Uuid
  shopId    String         @db.Uuid
  role      ShopMemberRole @default(OWNER)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // A user can hold only one membership row per shop.
  @@unique([userId, shopId])
  @@index([shopId])
  @@index([userId])
  @@map("shop_members")
}

// -------------------------------------------------------------------------
// Categories (self-referencing tree)
// -------------------------------------------------------------------------

model Category {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String         @unique
  parentId  String?        @db.Uuid
  status    CategoryStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model CategoryTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String  @db.Uuid
  locale      Locale
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([name])
  @@map("category_translations")
}

// -------------------------------------------------------------------------
// Products
// -------------------------------------------------------------------------

model Product {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId       String              @db.Uuid
  categoryId   String?             @db.Uuid
  price        Decimal             @db.Decimal(12, 2)
  currency     String              @default("TJS")
  status       ProductStatus       @default(PENDING)
  availability ProductAvailability @default(IN_STOCK)

  // v2 inventory fields. All optional so existing rows stay valid.
  // stockQuantity is the count on hand; stockUnit its unit (e.g. "pcs", "m2").
  stockQuantity   Int?
  stockUnit       String?
  lastStockUpdate DateTime?

  // v2 comparison fields. brand + attributes help match equivalent products
  // across shops without relying on names alone. attributes is free-form JSON
  // like { "size": "60x60", "material": "ceramic" }.
  brand      String?
  attributes Json?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category     Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translations ProductTranslation[]
  images       ProductImage[]

  // v2 relations
  priceHistory ProductPriceHistory[]
  favoritedBy  FavoriteProduct[]
  views        ProductView[]
  inquiries    Inquiry[]

  @@index([shopId])
  @@index([categoryId])
  @@index([status])
  @@index([availability])
  @@index([deletedAt])
  @@index([brand])
  @@map("products")
}

model ProductTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String  @db.Uuid
  locale      Locale
  name        String
  description String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([name])
  @@map("product_translations")
}

model ProductImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String   @db.Uuid
  imageUrl   String
  // The storage key is the path/object name inside the bucket. We keep it so
  // we can delete the real file later. Never trust a client-supplied key.
  storageKey String
  altText    String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// -------------------------------------------------------------------------
// Market map: Gates -> Sections -> Shops
// -------------------------------------------------------------------------

model Gate {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String          @unique
  // Coordinates are optional until physically verified. Do not invent them.
  latitude  Decimal?        @db.Decimal(9, 6)
  longitude Decimal?        @db.Decimal(9, 6)
  // v2: schematic (indoor) map position for a drawn floor-plan, 0..1 relative
  // coordinates. Separate from real GPS; both are optional.
  posX      Decimal?        @db.Decimal(9, 6)
  posY      Decimal?        @db.Decimal(9, 6)
  isDemo    Boolean         @default(false)
  status    PlacementStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  translations GateTranslation[]
  sections     Section[]

  @@index([status])
  @@map("gates")
}

model GateTranslation {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateId String @db.Uuid
  locale Locale
  name   String

  gate Gate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([gateId, locale])
  @@map("gate_translations")
}

model Section {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gateId    String          @db.Uuid
  code      String          @unique
  // v2: human-friendly row number within the gate (for navigation).
  rowNumber String?
  latitude  Decimal?        @db.Decimal(9, 6)
  longitude Decimal?        @db.Decimal(9, 6)
  // v2: schematic (indoor) map position, 0..1 relative coordinates.
  posX      Decimal?        @db.Decimal(9, 6)
  posY      Decimal?        @db.Decimal(9, 6)
  isDemo    Boolean         @default(false)
  status    PlacementStatus @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  gate         Gate                 @relation(fields: [gateId], references: [id], onDelete: Cascade)
  translations SectionTranslation[]
  shops        Shop[]

  @@index([gateId])
  @@index([status])
  @@map("sections")
}

model SectionTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sectionId   String  @db.Uuid
  locale      Locale
  name        String
  description String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, locale])
  @@map("section_translations")
}

// -------------------------------------------------------------------------
// Advertisements
// -------------------------------------------------------------------------

model Advertisement {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String              @db.Uuid
  title     String
  imageUrl  String?
  startDate DateTime
  endDate   DateTime
  status    AdvertisementStatus @default(DRAFT)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("advertisements")
}

// -------------------------------------------------------------------------
// Subscriptions (B2B SaaS monthly billing)
// -------------------------------------------------------------------------

model Subscription {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // A subscription belongs to a shop (the paying B2B customer).
  shopId      String             @db.Uuid
  planName    String
  amount      Decimal            @db.Decimal(12, 2)
  currency    String             @default("TJS")
  billingPeriod BillingPeriod    @default(MONTHLY)
  status      SubscriptionStatus @default(ACTIVE)
  startsAt    DateTime
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  shop     Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  invoices SubscriptionInvoice[]

  @@index([shopId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// Manual invoice/payment tracking until a real payment gateway is integrated.
model SubscriptionInvoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("TJS")
  status         InvoiceStatus @default(UNPAID)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime?
  note           String?
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_invoices")
}

// -------------------------------------------------------------------------
// Audit logs
// -------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // userId is optional: some events (e.g. anonymous) may have no user.
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  // Arbitrary context. NEVER store passwords, tokens, or secrets here.
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -------------------------------------------------------------------------
// System settings (key/value, editable by SUPER_ADMIN)
// -------------------------------------------------------------------------

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// =========================================================================
// v2.0 additions
// =========================================================================

// -------------------------------------------------------------------------
// Price history — one row per meaningful price change of a product.
// -------------------------------------------------------------------------
model ProductPriceHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  // oldPrice is null for the very first recorded price.
  oldPrice  Decimal? @db.Decimal(12, 2)
  newPrice  Decimal  @db.Decimal(12, 2)
  currency  String   @default("TJS")
  // Who made the change (seller/admin). Plain string (no FK) — this is a
  // historical record that must survive even if the user is later removed.
  changedByUserId String? @db.Uuid
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@map("product_price_history")
}

// -------------------------------------------------------------------------
// Favorites — a customer can favorite products and shops.
// -------------------------------------------------------------------------
model FavoriteProduct {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // A user can favorite a given product only once.
  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorite_products")
}

model FavoriteShop {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  shopId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
  @@map("favorite_shops")
}

// -------------------------------------------------------------------------
// View tracking — cheap, deduped analytics for sellers.
// We store at most one row per (entity, viewer, day) via a unique constraint,
// so repeated views in the same day do not inflate counts or create writes.
// `viewerKey` is a non-identifying hash (user id or hashed IP) — no PII.
// -------------------------------------------------------------------------
model ProductView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @db.Uuid
  viewerKey String
  // The calendar day (midnight UTC) the view happened — the dedup bucket.
  viewedOn  DateTime @db.Date
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, viewerKey, viewedOn])
  @@index([productId])
  @@map("product_views")
}

model ShopView {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @db.Uuid
  viewerKey String
  viewedOn  DateTime @db.Date
  createdAt DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, viewerKey, viewedOn])
  @@index([shopId])
  @@map("shop_views")
}

// -------------------------------------------------------------------------
// Notifications — in-app only (no WebSockets).
// -------------------------------------------------------------------------
model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String?
  // Extra structured context, e.g. { productId, oldPrice, newPrice }.
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

// -------------------------------------------------------------------------
// Customer <-> Seller inquiries (simple threaded messages).
// -------------------------------------------------------------------------
model Inquiry {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String        @db.Uuid
  shopId     String        @db.Uuid
  // Optional: the product the question is about.
  productId  String?       @db.Uuid
  subject    String?
  status     InquiryStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer User             @relation("CustomerInquiries", fields: [customerId], references: [id], onDelete: Cascade)
  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  messages InquiryMessage[]

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@map("inquiries")
}

model InquiryMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inquiryId String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("inquiry_messages")
}
